# Copy to .env.local for local builds. In CI these are set by the deploy workflow.

# YouTube Data API v3 key (https://console.cloud.google.com/ -> APIs & Services -> Credentials)
# Required to fetch popular videos at build time. Without it, data/youtube.json placeholder is used.
YOUTUBE_API_KEY=

# YouTube channel handle (without the @) - already defaulted in scripts/fetch-data.mjs
YOUTUBE_HANDLE=Mining2003

# Medium username (without the @)
MEDIUM_USERNAME=prasannasanjay1

# Base path for GitHub Pages project site. Empty for local dev.
NEXT_PUBLIC_BASE_PATH=
